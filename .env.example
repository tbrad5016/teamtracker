# Copy this file to ".env" (same folder) and replace the values.
# ".env" is listed in .gitignore, so your real passwords never reach GitHub.
# Use only letters and numbers in the password (symbols like $ can confuse Docker).

# Password for the PostgreSQL database (used by Docker AND by the Python code).
POSTGRES_PASSWORD=change_me_to_a_password

# Signs the login cookie. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change_me_to_a_long_random_string

# Port on your computer that PostgreSQL is reachable on (must match in both places).
DB_PORT=5435
